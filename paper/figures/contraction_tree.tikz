\begin{tikzpicture}[
  >=latex,
  tcgv9/.style = {circle, draw=green!45!black, fill=green!20,
    line width=1pt, minimum size=6mm, inner sep=1pt, font=\small},
  tcgv5/.style = {circle, draw=blue!60!black, fill=blue!10,
    line width=1pt, minimum size=6mm, inner sep=1pt, font=\small},
  tcgv6/.style = {circle, draw=orange!70!black, fill=orange!15,
    line width=1pt, minimum size=6mm, inner sep=1pt, font=\small},
  tcgv7/.style = {circle, draw=purple!60!black, fill=purple!15,
    line width=1pt, minimum size=6mm, inner sep=1pt, font=\small},
  tcgv8/.style = {circle, draw=red!65!black, fill=red!20,
    line width=1pt, minimum size=6mm, inner sep=1pt, font=\small},
  tcgv1/.style = {circle, draw=teal!70!black, fill=teal!15,
    line width=1pt, minimum size=6mm, inner sep=1pt, font=\small},
  tcgv2/.style = {circle, draw=orange!80!black, fill=orange!20,
    line width=1pt, minimum size=6mm, inner sep=1pt, font=\small},
  tcgv3/.style = {circle, draw=blue!80!black, fill=blue!10,
    line width=1pt, minimum size=6mm, inner sep=1pt, font=\small},
  tcgv4/.style = {circle, draw=magenta!70!black, fill=magenta!15,
    line width=1pt, minimum size=6mm, inner sep=1pt, font=\small},
  level 1/.style = {sibling distance=4.2em},
  level 2/.style = {sibling distance=2.2em},
  edge from parent/.style = {draw, ->, >=latex, thin}
]
  \node[tcgv9] {$v_9$}
    child { node[tcgv5] {$v_5$} }
    child { node[tcgv6] {$v_6$} }
    child { node[tcgv7] {$v_7$}
      child { node[tcgv1] {$v_1$} }
      child { node[tcgv2] {$v_2$} } }
    child { node[tcgv8] {$v_8$}
      child { node[tcgv3] {$v_3$} }
      child { node[tcgv4] {$v_4$} } };
\end{tikzpicture}
