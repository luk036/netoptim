\begin{tikzpicture}[
  >=latex,
  tcgv1/.style = {circle, draw=green!45!black, fill=green!20,
    line width=1pt, minimum size=8mm, inner sep=1pt, font=\small},
  tcgv2/.style = {circle, draw=blue!60!black, fill=blue!10,
    line width=1pt, minimum size=8mm, inner sep=1pt, font=\small},
  sedge/.style = {->, >=latex, semithick},
  lbl/.style = {fill=gray!15, inner sep=1.5pt, rounded corners=1pt,
    font=\scriptsize}
]
  \node[tcgv1] (ui) at (0,0) {$u_i$};
  \node[tcgv2] (uj) at (4,0) {$u_j$};

  \draw[sedge] (ui) to[bend left=28]
    node[lbl, above] {$\mathrm{CP}-4$} (uj);
  \draw[sedge] (uj) to[bend left=28]
    node[lbl, below] {$1.5$} (ui);
\end{tikzpicture}
