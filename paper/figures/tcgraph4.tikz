\begin{tikzpicture}[
  >=latex,
  tcgv2/.style = {circle, draw=blue!60!black, fill=blue!10,
    line width=1pt, minimum size=8mm, inner sep=1pt, font=\small},
  tcgcrit/.style = {circle, draw=red!65!black, fill=red!20,
    line width=1pt, minimum size=8mm, inner sep=1pt, font=\small},
  sedge/.style = {->, >=latex, semithick},
  dedge/.style = {->, >=latex, dotted, semithick},
  lbl/.style = {fill=gray!15, inner sep=1.5pt, rounded corners=1pt,
    font=\scriptsize}
]
  \node[tcgcrit] (v1) at (0,0) {$0.5$};
  \node[tcgv2]   (v2) at (2.5,0.4) {$v_2$};
  \node[tcgcrit] (v3) at (5.0,0) {$0$};

  % s-edges (solid)
  \draw[sedge] (v1) to[bend left=22]
    node[lbl, above] {$2.5$} (v2);
  \draw[sedge] (v2) to[bend left=22]
    node[lbl, above] {$1.5$} (v3);
  \draw[sedge] (v3) to[bend left=28]
    node[lbl, below] {$0.5$} (v1);

  % h-edges (dotted)
  \draw[dedge] (v1) to[bend right=8]
    node[lbl, above] {$2$} (v2);
  \draw[dedge] (v2) to[bend right=8]
    node[lbl, above] {$3$} (v3);
  \draw[dedge] (v3) to[bend left=8]
    node[lbl, above] {$1.5$} (v1);
\end{tikzpicture}
