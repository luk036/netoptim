\begin{tikzpicture}[
  >=latex,
  tcgv2/.style = {circle, draw=blue!60!black, fill=blue!10,
    line width=1pt, minimum size=8mm, inner sep=1pt, font=\small},
  tcgvs/.style = {circle, draw=red!65!black, fill=red!20,
    line width=1pt, minimum size=8mm, inner sep=1pt, font=\small},
  sedge/.style = {->, >=latex, semithick},
  dedge/.style = {->, >=latex, dotted, semithick},
  lbl/.style = {fill=gray!15, inner sep=1.5pt, rounded corners=1pt,
    font=\scriptsize}
]
  \node[tcgvs] (vs) at (0,0) {$v_s$};
  \node[tcgv2] (v2) at (2.9,0) {$v_2$};

  % s-edges (solid)
  \draw[sedge] (vs) to[bend left=45]
    node[lbl, above] {$2$} (v2);
  \draw[sedge] (v2) to[bend left=45]
    node[lbl, below] {$1.5$} (vs);

  % h-edges (dotted)
  \draw[dedge] (vs) to[bend left=12]
    node[lbl, above] {$2.5$} (v2);
  \draw[dedge] (v2) to[bend left=12]
    node[lbl, below] {$3$} (vs);
\end{tikzpicture}
