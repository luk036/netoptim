\begin{tikzpicture}[
  >=latex,
  tcgv1/.style = {circle, draw=purple!60!black, fill=purple!15,
    line width=1pt, minimum size=8mm, inner sep=1pt, font=\small},
  tcgv2/.style = {circle, draw=blue!60!black, fill=blue!10,
    line width=1pt, minimum size=8mm, inner sep=1pt, font=\small},
  tcgv3/.style = {circle, draw=orange!70!black, fill=orange!15,
    line width=1pt, minimum size=8mm, inner sep=1pt, font=\small},
  sedge/.style = {->, >=latex, semithick},
  dedge/.style = {->, >=latex, dotted, semithick},
  lbl/.style = {fill=gray!15, inner sep=1.5pt, rounded corners=1pt,
    font=\scriptsize}
]
  \node[tcgv1] (v1) at (0,0) {$v_1$};
  \node[tcgv2] (v2) at (2.9,0.45) {$v_2$};
  \node[tcgv3] (v3) at (5.8,0) {$v_3$};

  % s-edges (solid): each weight is a (mean, variance) pair
  \draw[sedge] (v1) to[bend left=22]
    node[lbl, above] {$(2.5,3.1)$} (v2);
  \draw[sedge] (v2) to[bend left=22]
    node[lbl, above] {$(1.5,4.1)$} (v3);
  \draw[sedge] (v3) to[bend left=28]
    node[lbl, below] {$(0.5,5.1)$} (v1);

  % h-edges (dotted)
  \draw[dedge] (v1) to[bend right=8]
    node[lbl, above] {$(2,2.2)$} (v2);
  \draw[dedge] (v2) to[bend right=8]
    node[lbl, above] {$(3,1.5)$} (v3);
  \draw[dedge] (v3) to[bend left=25]
    node[lbl, above] {$(1.5,0.7)$} (v1);
\end{tikzpicture}
